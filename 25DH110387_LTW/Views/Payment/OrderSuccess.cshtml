@model _25DH110387_LTW.Models.Order
@{
    ViewBag.Title = "Xác nhận đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>XÁC NHẬN ĐƠN HÀNG</h2>
<p>Cảm ơn bạn đã đặt hàng! Mã đơn hàng: <strong>#@Model.OrderID</strong></p>

<table class="table">
    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>
                    <img src="@Url.Content(item.Product.ProductImage)" alt="" style="max-height:40px;" />
                    @item.Product.ProductName
                </td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("0")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("0"))</td>
            </tr>
        }
    </tbody>
</table>

<h3>Thông tin giao hàng</h3>

<p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
<p><strong>Phương thức giao hàng:</strong> @Model.ShippingMethod</p>
<p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
<p><strong>Tổng giá trị:</strong> @Model.TotalAmount.ToString("N0")</p>

<a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-default">Tiếp tục mua sắm</a>