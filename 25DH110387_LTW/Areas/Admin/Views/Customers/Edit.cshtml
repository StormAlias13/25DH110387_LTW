@model _25DH110387_LTW.Models.Customer
@{ ViewBag.Title = "Thêm khách hàng"; }

<style>
    .box-head {
        background: #dff0d8;
        padding: 14px 18px;
    }

        .box-head h4 {
            margin: 0;
            color: #3c763d;
            text-transform: uppercase;
            font-weight: 400;
        }

    .box {
        border: 1px solid #ddd;
    }

        .box label.form-label {
            font-weight: 700;
            text-transform: uppercase;
            font-size: .8rem;
        }
</style>

<div class="box mt-3">
    <div class="box-head"><h4>Quản lý khách hàng</h4></div>
    <div class="p-3">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CustomerID)
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.CustomerName, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.CustomerPhone, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", type = "tel" })
                    @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.CustomerEmail, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.CustomerAddress, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                    @Html.DropDownList("Username", null, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>
            </div>

            <button type="submit" class="btn btn-outline-secondary">Thêm mới</button>
            <button type="reset" class="btn btn-outline-secondary">Nhập lại</button>
            @Html.ActionLink("Danh sách", "Index", null, new { @class = "btn btn-outline-secondary" })
        }
    </div>
</div>

@section Scripts { @Scripts.Render("~/bundles/jqueryval") }